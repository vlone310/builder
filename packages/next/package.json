{
  "name": "@builder/next",
  "version": "0.1.0",
  "description": "Next.js integration for builder host apps: edit route helpers, edit-token verification",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
