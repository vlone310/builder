{
  "name": "@builder/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema, migrations, tenancy helpers and seed data for the builder platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env src/bin/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/bin/seed.ts"
  },
  "dependencies": {
    "@builder/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
