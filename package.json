{
  "name": "builder",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @builder/db migrate",
    "db:seed": "pnpm --filter @builder/db seed",
    "e2e": "pnpm --filter @builder/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
