DATABASE_URL=postgres://builder:builder@localhost:5432/builder
PORT=4002
# Poll the outbox every N ms; 0 disables the loop (use POST /run from a cron instead)
WORKER_POLL_MS=2000
# Bearer token for POST /run
WORKER_RUN_SECRET=change-me
# Allow webhooks to private and loopback addresses. Development only.
WEBHOOK_ALLOW_PRIVATE=1
# Cloudflare purge by cache tag; unset = no CDN (purges are logged and skipped)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
