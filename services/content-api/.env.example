DATABASE_URL=postgres://builder:builder@localhost:5432/builder
CONTENT_API_JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
PORT=4000
# Issuer of edit tokens; hosts fetch $CONTENT_API_PUBLIC_URL/.well-known/jwks.json
CONTENT_API_PUBLIC_URL=http://localhost:4000
# pnpm --filter @builder/content-api keys:generate (ephemeral key if unset; dev only)
EDIT_TOKEN_PRIVATE_JWK=
# Comma-separated browser origins allowed by CORS
EDITOR_ORIGIN=http://localhost:5173
# Where invite links open; defaults to the first EDITOR_ORIGIN
EDITOR_URL=
# Passwordless POST /auth/dev-login; never enable in production
CONTENT_API_DEV_LOGIN=1
# Sign-in with Keycloak; off when KEYCLOAK_ISSUER is unset
KEYCLOAK_ISSUER=http://localhost:8080/realms/builder
# Access tokens must carry this audience (the realm's audience mapper adds it)
KEYCLOAK_AUDIENCE=builder-content-api
# The editor's public OIDC client
KEYCLOAK_EDITOR_CLIENT_ID=builder-editor
# Only when the issuer URL is not reachable from the API (e.g. inside docker compose)
KEYCLOAK_JWKS_URL=
# Invite emails; without SMTP_URL they are printed to the log. Local Mailpit: smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Builder <no-reply@builder.local>
