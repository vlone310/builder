{
  "name": "@builder/content-api",
  "version": "0.1.0",
  "private": true,
  "description": "Write API for sites, environments, pages, drafts, revisions and API keys",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "token": "tsx --env-file-if-exists=.env src/dev-token.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "keys:generate": "tsx src/generate-key.ts"
  },
  "dependencies": {
    "@builder/core": "workspace:*",
    "@builder/db": "workspace:*",
    "@hono/node-server": "2.1.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
